# Telegram: create a bot with @BotFather, send it any message, then find your
# numeric chat id (for example with @userinfobot). Only this chat can use the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI scoring and letters: any OpenAI-compatible endpoint
# (OpenRouter, OpenAI, a local Ollama or LM Studio server, ...).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=

# Optional: route all portal requests through one HTTP(S) proxy.
HTTP_PROXY_URL=

# Optional: override the User-Agent sent to the portals.
USER_AGENT=

# Optional: path to the search config (default: ./search.toml)
SEARCH_CONFIG=search.toml
